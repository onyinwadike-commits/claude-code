# Walmart Ops - Environment Variables Template
# Copy this file to .env.local and fill in the values

# =============================================================================
# APPLICATION
# =============================================================================
NEXT_PUBLIC_APP_NAME="Walmart Ops"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NODE_ENV="development"

# =============================================================================
# API CONFIGURATION
# =============================================================================
# WebSocket server URL (for real-time updates)
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
# REST API URL
NEXT_PUBLIC_API_URL="http://localhost:3001"

# =============================================================================
# LLM PROVIDERS (Phase 2 - Multi-LLM Engine)
# =============================================================================
# Perplexity AI
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="pplx-7b-online"

# Grok (xAI)
GROK_API_KEY=""
GROK_MODEL="grok-beta"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-pro"
GEMINI_VISION_MODEL="gemini-pro-vision"

# Anthropic Claude
CLAUDE_API_KEY=""
CLAUDE_MODEL="claude-3-sonnet-20240229"

# OpenAI ChatGPT
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4-turbo-preview"

# DeepSeek
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# =============================================================================
# LLM ORCHESTRATION
# =============================================================================
# Enable/disable specific LLM providers
LLM_ENABLE_PERPLEXITY="true"
LLM_ENABLE_GROK="true"
LLM_ENABLE_GEMINI="true"
LLM_ENABLE_CLAUDE="true"
LLM_ENABLE_OPENAI="true"
LLM_ENABLE_DEEPSEEK="true"

# Orchestration settings
LLM_CONSENSUS_THRESHOLD="0.7"
LLM_MAX_RETRIES="3"
LLM_TIMEOUT_MS="30000"
LLM_RATE_LIMIT_RPM="60"

# =============================================================================
# AMAZON WARFARE (Phase 3)
# =============================================================================
# Amazon price tracking
AMAZON_TRACKING_ENABLED="true"
AMAZON_API_KEY=""
AMAZON_REFRESH_INTERVAL_MS="300000"

# Competitive intelligence
PRICE_ALERT_THRESHOLD_PERCENT="5"
THREAT_LEVEL_UPDATE_INTERVAL_MS="60000"

# =============================================================================
# VISUAL MERCHANDISING (Phase 4)
# =============================================================================
# Image processing
VISION_API_ENABLED="true"
MAX_IMAGE_SIZE_MB="10"
SUPPORTED_IMAGE_FORMATS="jpg,jpeg,png,webp"

# Planogram settings
PLANOGRAM_SYNC_ENABLED="true"
COMPLIANCE_THRESHOLD="0.85"

# =============================================================================
# FEEDBACK SYSTEM (Phase 5)
# =============================================================================
# NPS Survey
NPS_SURVEY_ENABLED="true"
NPS_SURVEY_FREQUENCY_DAYS="30"

# Feedback analytics
FEEDBACK_ANALYTICS_ENABLED="true"

# =============================================================================
# REDIS (Caching & Pub/Sub)
# =============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_TLS_ENABLED="false"

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/walmart_ops"

# =============================================================================
# AUTHENTICATION (if applicable)
# =============================================================================
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL="info"
ENABLE_PERFORMANCE_LOGGING="true"

# Sentry (Error tracking)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# =============================================================================
# MARKET 396 STORE CONFIGURATION
# =============================================================================
# Default market
DEFAULT_MARKET_ID="396"
DEFAULT_STORE_ID="4158"

# Store IDs (comma-separated)
MARKET_396_STORES="4158,4201,4322,4189,4267,4298,4345,4412,4478"
