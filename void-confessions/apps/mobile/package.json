{
  "name": "@void-confessions/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "dev": "react-native start",
    "build": "echo 'Use native build tools'",
    "lint": "eslint src/",
