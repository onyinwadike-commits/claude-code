# Walmart Store Orchestrator - Environment Variables
# Copy this file to .env.local and fill in your API keys

# ============================================
# LLM API Keys (required for AI-powered reports)
# ============================================

# Perplexity AI - Research and web search
# Model: sonar-pro
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# xAI (Grok) - Real-time data and trend analysis
# Model: grok-2-latest
# Get your key at: https://console.x.ai/
XAI_API_KEY=

# Google AI (Gemini) - Visual analysis and multimodal
# Model: gemini-2.0-flash
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# Anthropic (Claude) - Strategic analysis and reasoning
# Model: claude-sonnet-4-20250514
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (ChatGPT) - General purpose tasks
# Model: gpt-4o
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek - Technical analysis and optimization
# Model: deepseek-chat
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ============================================
# Optional Configuration
# ============================================

# Report cache TTL in milliseconds (default: 5 minutes)
# REPORT_CACHE_TTL_MS=300000

# Maximum parallel LLM queries (default: 3)
# MAX_PARALLEL_QUERIES=3

# Minimum confidence threshold for including insights (default: 0.6)
# MIN_CONFIDENCE_THRESHOLD=0.6
